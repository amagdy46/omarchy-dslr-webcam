{
  "schemaVersion": 1,
  "id": "amagdy46.dslr-webcam",
  "name": "DSLR Webcam",
  "version": "0.1.0",
  "author": "amagdy46",
  "license": "MIT",
  "description": "Use a Canon/Nikon/Sony camera as an always-on webcam via gphoto2 and v4l2loopback, with a bar toggle.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "DSLR Webcam",
    "description": "Camera status; left-click toggles the stream, right-click opens a preview, middle-click restarts it.",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "hideWhenDisconnected": true,
      "pollIntervalSec": 3
    },
    "schema": [
      {
        "key": "hideWhenDisconnected",
        "type": "boolean",
        "label": "Hide when no camera is connected",
        "defaultValue": true
      },
      {
        "key": "pollIntervalSec",
        "type": "integer",
        "label": "Status refresh (seconds)",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 3
      }
    ]
  }
}
