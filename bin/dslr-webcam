#!/bin/bash

# dslr-webcam: use a gphoto2-supported camera (Canon EOS, Nikon, Sony, ...) as
# an always-on Linux webcam by piping its live view into a v4l2loopback device.

set -uo pipefail

VERSION="0.2.0"
SERVICE="dslr-webcam.service"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/dslr-webcam/config"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dslr-webcam"
DISABLED_FLAG="$STATE_DIR/disabled"
MODEL_FILE="$STATE_DIR/model"
WRITER_PID_FILE="$STATE_DIR/writer.pid"

# Defaults. Users override them in $CONFIG_FILE; config.example documents each.
CONFIG_KEYS=(RESOLUTION CROP MIRROR FPS HIDE_ROWS EXTRA_FILTERS KEEP_AWAKE DEVICE LABEL)
DSLR_WEBCAM_RESOLUTION="1280x720"
DSLR_WEBCAM_CROP="center"
DSLR_WEBCAM_MIRROR=0
DSLR_WEBCAM_FPS=""
DSLR_WEBCAM_HIDE_ROWS=""
DSLR_WEBCAM_EXTRA_FILTERS=""
DSLR_WEBCAM_KEEP_AWAKE=1
DSLR_WEBCAM_DEVICE=""
DSLR_WEBCAM_LABEL="DSLR Webcam"

# shellcheck source=/dev/null
[[ -f $CONFIG_FILE ]] && source "$CONFIG_FILE"

log() { echo "dslr-webcam: $*" >&2; }
die() { log "$*"; exit 1; }

notify() {
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send "$@" >/dev/null 2>&1 &
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "$@" >/dev/null 2>&1 &
  fi
}

# --- Detection ---------------------------------------------------------------

# Prints "busnum devnum product" for the first USB still-image (PTP) camera.
# Reads sysfs only, so it never claims the camera away from a running stream.
camera_usb() {
  local intf dev
  for intf in /sys/bus/usb/devices/*:*; do
    [[ $(cat "$intf/bInterfaceClass" 2>/dev/null) == 06 ]] || continue
    dev="${intf%:*}"
    printf '%s %s %s\n' "$(cat "$dev/busnum")" "$(cat "$dev/devnum")" "$(cat "$dev/product" 2>/dev/null || echo Camera)"
    return 0
  done
  return 1
}

camera_connected() { camera_usb >/dev/null; }

camera_model() {
  local usb
  usb=$(camera_usb) || return 1
  if [[ -s $MODEL_FILE ]]; then cat "$MODEL_FILE"; else echo "${usb#* * }"; fi
}

is_loopback() {
  v4l2-ctl -d "$1" --info 2>/dev/null | grep -qi 'loopback'
}

loopback_device() {
  local dev name fallback=""
  if [[ -n $DSLR_WEBCAM_DEVICE ]]; then
    [[ -e $DSLR_WEBCAM_DEVICE ]] && echo "$DSLR_WEBCAM_DEVICE" && return 0
    return 1
  fi
  for dev in /sys/devices/virtual/video4linux/video*; do
    [[ -e $dev ]] || continue
    name=$(cat "$dev/name" 2>/dev/null)
    is_loopback "/dev/${dev##*/}" || continue
    if [[ $name == "$DSLR_WEBCAM_LABEL" ]]; then echo "/dev/${dev##*/}"; return 0; fi
    [[ -z $fallback ]] && fallback="/dev/${dev##*/}"
  done
  [[ -n $fallback ]] && echo "$fallback" && return 0
  return 1
}

# PIDs of processes reading the loopback device, excluding our own writer.
consumers() {
  local dev="$1" writer="" pid
  [[ -f $WRITER_PID_FILE ]] && writer=$(cat "$WRITER_PID_FILE")
  for pid in $(fuser "$dev" 2>/dev/null); do
    [[ $pid == "$writer" ]] && continue
    echo "$pid"
  done
}

consumer_names() {
  local pid
  for pid in $(consumers "$1"); do
    cat "/proc/$pid/comm" 2>/dev/null
  done | sort -u | paste -sd, -
}

service_state() { systemctl --user is-active "$SERVICE" 2>/dev/null || true; }

# --- Streaming ---------------------------------------------------------------

# A camera with a defective sensor row can show a bright or dark line in live
# view only (stills are defect-mapped). Prints HIDE_ROWS as "Y:H", widened to
# even rows because 4:2:0 crops and overlays snap to even rows.
hidden_rows() {
  [[ $DSLR_WEBCAM_HIDE_ROWS =~ ^([0-9]+):([0-9]+)$ ]] || return 0
  local y=${BASH_REMATCH[1]} n=${BASH_REMATCH[2]} end
  end=$(( y + n ))
  y=$(( y - y % 2 ))
  end=$(( end + end % 2 ))
  echo "$y:$(( end - y ))"
}

video_filters() {
  local filters="" w h patch y n crop_y
  case "$DSLR_WEBCAM_CROP" in
    top) crop_y="0" ;;
    bottom) crop_y="ih-oh" ;;
    *) crop_y="(ih-oh)/2" ;;
  esac
  patch=$(hidden_rows)
  if [[ $patch == *:* ]]; then
    y=${patch%:*}
    n=${patch#*:}
  fi
  if [[ $DSLR_WEBCAM_RESOLUTION != native ]]; then
    w=${DSLR_WEBCAM_RESOLUTION%x*}
    h=${DSLR_WEBCAM_RESOLUTION#*x}
    if [[ -n ${y:-} ]]; then
      # Slide the crop window off the hidden band: keep it where CROP put it
      # if it already misses the band, otherwise end it just above (or start
      # just below) the band.
      crop_y="if(lt($y,($crop_y)+oh)*gt($((y + n)),$crop_y),if(gte($y-oh,0),$y-oh,$((y + n))),$crop_y)"
    fi
    # Crop the camera's 3:2 live view to the target aspect, then scale.
    filters="crop='min(iw,ih*$w/$h)':'min(ih,iw*$h/$w)':'(iw-ow)/2':'$crop_y',scale=$w:$h"
  elif [[ -n ${y:-} ]]; then
    # Full frame requested, so the band can only be covered: copy the rows
    # directly above it over it.
    filters="split[dw_main][dw_src];[dw_src]crop=iw:$n:0:$((y - n))[dw_patch];[dw_main][dw_patch]overlay=0:$y"
  fi
  [[ $DSLR_WEBCAM_MIRROR == 1 ]] && filters="${filters:+$filters,}hflip"
  [[ -n $DSLR_WEBCAM_FPS ]] && filters="${filters:+$filters,}fps=$DSLR_WEBCAM_FPS"
  [[ -n $DSLR_WEBCAM_EXTRA_FILTERS ]] && filters="${filters:+$filters,}$DSLR_WEBCAM_EXTRA_FILTERS"
  echo "${filters:+$filters,}format=yuv420p"
}

prepare_camera() {
  local model
  model=$(gphoto2 --auto-detect 2>/dev/null | awk 'NR>2 && NF { sub(/[[:space:]]+usb:.*/, ""); print; exit }')
  [[ -n $model ]] && printf '%s\n' "$model" >"$MODEL_FILE"
  if [[ $DSLR_WEBCAM_KEEP_AWAKE == 1 ]]; then
    gphoto2 --set-config autopoweroff=0 >/dev/null 2>&1 || true
  fi
}

release_gvfs() {
  # gvfs mounts the camera as a filesystem and holds the PTP session.
  command -v gio >/dev/null 2>&1 || return 0
  gio mount -l 2>/dev/null | grep -o 'gphoto2://[^ ]*' | sort -u | while read -r uri; do
    gio mount -u "$uri" >/dev/null 2>&1 || true
  done
  pkill -x gvfsd-gphoto2 2>/dev/null || true
}

stream_once() {
  local dev="$1" vf
  vf=$(video_filters)
  log "streaming $(camera_model) -> $dev ($DSLR_WEBCAM_RESOLUTION)"
  gphoto2 --stdout --capture-movie 2> >(grep -v -E '^(Capturing preview frames|Movie capture)' >&2) |
    ffmpeg -hide_banner -loglevel error -nostats \
      -fflags nobuffer -flags low_delay -f mjpeg -i - \
      -vf "$vf" -f v4l2 "$dev" &
  echo $! >"$WRITER_PID_FILE"
  local started=$SECONDS rc
  wait $!
  rc=$?
  rm -f "$WRITER_PID_FILE"
  # A stream that ran for a while was healthy; don't count it toward giving up.
  (( SECONDS - started > 60 )) && failures=0
  return $rc
}

cmd_run() {
  mkdir -p "$STATE_DIR"
  if [[ -e $DISABLED_FLAG ]]; then
    log "disabled (run 'dslr-webcam on' to enable)"
    exit 0
  fi
  local dev failures=0
  dev=$(loopback_device) || die "no v4l2loopback device found; run 'dslr-webcam doctor'"

  trap 'pkill -P $$ 2>/dev/null; rm -f "$WRITER_PID_FILE"; exit 0' TERM INT

  # Stopping a stream mid-transfer leaves the camera's PTP session wedged, so
  # start every run from a clean USB state.
  gphoto2 --reset >/dev/null 2>&1 && sleep 3

  while true; do
    if ! camera_connected; then
      log "camera disconnected"
      exit 0
    fi
    release_gvfs
    prepare_camera
    stream_once "$dev"
    # Give USB a moment to settle before deciding whether the camera is gone.
    sleep 2
    camera_connected || { log "camera disconnected"; exit 0; }
    failures=$((failures + 1))
    log "stream stopped (attempt $failures); resetting camera and restarting"
    # A PTP timeout wedges the camera's USB session until it is reset.
    gphoto2 --reset >/dev/null 2>&1 || true
    sleep 3
    if (( failures >= 5 )); then
      notify -u critical "DSLR webcam" "Live view keeps failing. Is the camera on and in photo mode?"
      exit 1
    fi
  done
}

# --- Control -----------------------------------------------------------------

cmd_on() {
  mkdir -p "$STATE_DIR"
  rm -f "$DISABLED_FLAG"
  if camera_connected; then
    systemctl --user restart "$SERVICE"
  else
    log "enabled; streaming will start when the camera is connected"
  fi
}

cmd_off() {
  mkdir -p "$STATE_DIR"
  touch "$DISABLED_FLAG"
  systemctl --user stop "$SERVICE"
}

cmd_toggle() {
  if [[ -e $DISABLED_FLAG ]]; then
    cmd_on && notify "DSLR webcam" "Webcam on"
  else
    cmd_off && notify "DSLR webcam" "Webcam off"
  fi
}

json_escape() {
  local s="${1//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '"%s"' "$s"
}

cmd_status() {
  local json=0 dev="" model="" camera=false enabled=true state names=""
  [[ ${1:-} == --json ]] && json=1
  [[ -e $DISABLED_FLAG ]] && enabled=false
  camera_connected && camera=true && model=$(camera_model)
  dev=$(loopback_device 2>/dev/null) || dev=""
  state=$(service_state)
  [[ -n $dev ]] && names=$(consumer_names "$dev")

  if (( json )); then
    printf '{"installed":true,"enabled":%s,"camera":%s,"model":%s,"service":%s,"device":%s,"consumers":%s}\n' \
      "$enabled" "$camera" "$(json_escape "$model")" "$(json_escape "$state")" \
      "$(json_escape "$dev")" "$(json_escape "$names")"
    return 0
  fi

  echo "enabled:   $enabled"
  echo "camera:    ${model:-not connected}"
  echo "service:   $state"
  echo "device:    ${dev:-none (v4l2loopback not loaded)}"
  echo "in use by: ${names:-nothing}"
}

cmd_preview() {
  local dev
  dev=$(loopback_device) || die "no v4l2loopback device found"
  if command -v mpv >/dev/null 2>&1; then
    exec mpv --title="DSLR webcam preview" --profile=low-latency --untimed --no-cache \
      --demuxer-lavf-format=video4linux2 "av://v4l2:$dev"
  elif command -v ffplay >/dev/null 2>&1; then
    exec ffplay -hide_banner -loglevel error -window_title "DSLR webcam preview" \
      -fflags nobuffer -f v4l2 "$dev"
  fi
  die "install mpv or ffplay to preview"
}

# --- Configuration -----------------------------------------------------------

template_file() {
  local dir
  dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.."
  echo "$dir/config.example"
}

ensure_config() {
  [[ -f $CONFIG_FILE ]] && return 0
  mkdir -p "$(dirname "$CONFIG_FILE")"
  if [[ -f $(template_file) ]]; then
    cp "$(template_file)" "$CONFIG_FILE"
  else
    echo "# dslr-webcam settings; see 'dslr-webcam config --show'" >"$CONFIG_FILE"
  fi
}

# Sets KEY=value in the config, replacing an existing or commented-out line.
set_config() {
  local key="DSLR_WEBCAM_$1" value="$2" line
  ensure_config
  line="$key=\"$value\""
  if grep -qE "^#?$key=" "$CONFIG_FILE"; then
    sed -i -E "s|^#?$key=.*|$line|" "$CONFIG_FILE"
  else
    echo "$line" >>"$CONFIG_FILE"
  fi
}

cmd_config() {
  case "${1:-}" in
    --show | show)
      local key var
      echo "# $CONFIG_FILE$([[ -f $CONFIG_FILE ]] || echo ' (not created yet, all defaults)')"
      for key in "${CONFIG_KEYS[@]}"; do
        var="DSLR_WEBCAM_$key"
        printf '%-26s = %s\n' "$var" "${!var:-(empty)}"
      done
      ;;
    --path | path)
      echo "$CONFIG_FILE"
      ;;
    --reset | reset)
      [[ -f $CONFIG_FILE ]] && mv "$CONFIG_FILE" "$CONFIG_FILE.bak.$(date +%s)" && log "old config backed up"
      ensure_config
      ;;
    "")
      # Saved changes are applied by dslr-webcam-config.path, however the file
      # was edited.
      ensure_config
      if [[ -t 0 && -t 1 ]]; then
        ${EDITOR:-omarchy-launch-editor --inline} "$CONFIG_FILE"
      elif command -v omarchy-launch-editor >/dev/null 2>&1; then
        omarchy-launch-editor "$CONFIG_FILE"
      else
        xdg-open "$CONFIG_FILE"
      fi
      ;;
    *)
      die "usage: dslr-webcam config [--show | --path | --reset]"
      ;;
  esac
}

# --- Line scan ---------------------------------------------------------------

# Prints the mean brightness of every row of an image, one per line.
row_means() {
  ffmpeg -v error -i "$1" -vf "format=gray,scale=1:ih:flags=area" -f rawvideo - | od -An -tu1 -v | tr -s ' ' '\n' | grep -v '^$'
}

# Looks for rows that stand out from the rows around them in every one of
# several live view frames: the signature of a defective sensor row rather
# than something in the scene.
cmd_scan() {
  local was_active=0 frames=() i bands
  command -v gphoto2 >/dev/null || die "gphoto2 is not installed"
  camera_connected || die "no camera connected"
  [[ $(service_state) == active ]] && was_active=1
  SCAN_TMP=$(mktemp -d)
  trap 'rm -rf "$SCAN_TMP"' EXIT

  echo "Looking for a fixed line in the camera's live view."
  echo "Aim the camera at a plain, evenly lit surface (a wall works) and keep it still."
  (( was_active )) && log "pausing the stream" && systemctl --user stop "$SERVICE"
  gphoto2 --reset >/dev/null 2>&1 && sleep 3
  for i in 1 2 3 4 5; do
    gphoto2 --capture-preview --force-overwrite --filename "$SCAN_TMP/f$i.jpg" >/dev/null 2>&1 || true
    [[ -f $SCAN_TMP/thumb_f$i.jpg ]] && frames+=("$SCAN_TMP/thumb_f$i.jpg")
    sleep 0.5
  done
  (( was_active )) && log "resuming the stream" && systemctl --user start "$SERVICE"
  (( ${#frames[@]} >= 3 )) || die "could not capture live view frames"

  for i in "${!frames[@]}"; do row_means "${frames[$i]}" >"$SCAN_TMP/rows$i"; done

  # A row is flagged when it differs from the median of the 9 rows around it
  # by more than the threshold, in every frame. The median ignores the line
  # itself, so only the line's own rows are flagged.
  bands=$(paste "$SCAN_TMP"/rows* | awk -v threshold=8 '
    function median(y, f,   i, n, a, j, t) {
      n = 0
      for (i = y - 4; i <= y + 4; i++) a[++n] = v[i, f]
      for (i = 2; i <= n; i++) { t = a[i]; for (j = i - 1; j > 0 && a[j] > t; j--) a[j + 1] = a[j]; a[j + 1] = t }
      return a[5]
    }
    { for (f = 1; f <= NF; f++) v[NR, f] = $f; frames = NF; rows = NR }
    END {
      start = -1
      for (y = 5; y <= rows - 4; y++) {
        bad = 1
        for (f = 1; f <= frames; f++) {
          d = v[y, f] - median(y, f)
          if (d < threshold && d > -threshold) { bad = 0; break }
        }
        if (bad && start < 0) start = y
        if (!bad && start >= 0) { printf "%d:%d\n", start - 1, y - start; start = -1 }
      }
    }')

  if [[ -z $bands ]]; then
    echo "No fixed line found. Nothing to change."
    return 0
  fi
  if (( $(wc -l <<<"$bands") > 1 )); then
    echo "Found several lines, which is more likely the scene than the camera:"
    sed 's/^/  rows /' <<<"$bands"
    echo "Aim at a plain wall and run the scan again."
    return 1
  fi

  echo "Found a line at rows $bands (first row:number of rows) of the camera frame."
  if [[ $DSLR_WEBCAM_HIDE_ROWS == "$bands" ]]; then
    echo "It is already hidden by your config."
    return 0
  fi
  local answer=n
  if [[ ${1:-} == --yes || ${1:-} == -y ]]; then
    answer=y
  elif [[ -t 0 ]]; then
    read -r -p "Hide it by saving DSLR_WEBCAM_HIDE_ROWS=\"$bands\" to your config? [Y/n] " answer
    answer=${answer:-y}
  fi
  if [[ $answer =~ ^[Yy] ]]; then
    set_config HIDE_ROWS "$bands"
    echo "Saved to $CONFIG_FILE. The stream restarts with it in a moment."
  else
    echo "Not saved. To hide it later, set DSLR_WEBCAM_HIDE_ROWS=\"$bands\" in $CONFIG_FILE"
  fi
}

cmd_doctor() {
  local ok=1 dev
  check() {
    if eval "$2" >/dev/null 2>&1; then printf '  \e[32m✓\e[0m %s\n' "$1"
    else printf '  \e[31m✗\e[0m %s\n      %s\n' "$1" "$3"; ok=0; fi
  }
  echo "dslr-webcam $VERSION"
  check "gphoto2 installed" "command -v gphoto2" "sudo pacman -S gphoto2"
  check "ffmpeg installed" "command -v ffmpeg" "sudo pacman -S ffmpeg"
  check "v4l2-ctl installed" "command -v v4l2-ctl" "sudo pacman -S v4l-utils"
  check "fuser installed" "command -v fuser" "sudo pacman -S psmisc"
  check "v4l2loopback module loaded" "lsmod | grep -q '^v4l2loopback'" "run ./install.sh (installs v4l2loopback-dkms + modprobe config)"
  check "v4l2loopback device present" "loopback_device" "sudo modprobe v4l2loopback exclusive_caps=1 card_label='DSLR Webcam'"
  check "camera connected (USB PTP)" "camera_connected" "plug in the camera, turn it on, set the mode dial to a photo mode"
  check "udev autostart rule installed" "test -f /etc/udev/rules.d/90-dslr-webcam.rules" "run ./install.sh"
  check "systemd user service installed" "systemctl --user cat $SERVICE" "run ./install.sh"
  check "no gvfs gphoto2 mount holding the camera" "! pgrep -x gvfsd-gphoto2" "gio mount -u gphoto2://..., or uninstall gvfs-gphoto2"
  dev=$(loopback_device 2>/dev/null) && echo "  device: $dev ($(cat "/sys/class/video4linux/${dev##*/}/name" 2>/dev/null))"
  (( ok ))
}

usage() {
  cat <<EOF
dslr-webcam $VERSION: use a DSLR/mirrorless camera as an always-on webcam

Usage: dslr-webcam <command>

  on          Enable and start streaming (stays on across replugs and reboots)
  off         Stop streaming and keep it off until 'on'
  toggle      Switch between on and off
  restart     Restart the stream
  status      Show camera, service, device, and which apps are using it
              (--json for machine-readable output)
  preview     Open a low-latency preview window (mpv or ffplay)
  scan        Find a fixed line in the video (a bad sensor row) and offer to hide it
              (--yes saves the result without asking)
  config      Edit settings (--show: settings in effect, --reset: start over)
  doctor      Check dependencies and setup
  run         Stream in the foreground (used by the systemd service)

Config: $CONFIG_FILE
EOF
}

case "${1:-}" in
  run) cmd_run ;;
  on | start) cmd_on ;;
  off | stop) cmd_off ;;
  toggle) cmd_toggle ;;
  restart) rm -f "$DISABLED_FLAG"; systemctl --user restart "$SERVICE" ;;
  status) cmd_status "${2:-}" ;;
  preview) cmd_preview ;;
  scan) cmd_scan "${2:-}" ;;
  config) cmd_config "${2:-}" ;;
  doctor) cmd_doctor ;;
  version | --version) echo "$VERSION" ;;
  -h | --help | help | "") usage ;;
  *) usage >&2; exit 2 ;;
esac
